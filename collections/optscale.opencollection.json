          "info": {
            "name": "Get an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/restapi/v2/organizations/:organization_id",
            "params": [
              {
                "name": "organization_id",
                "value": "",
