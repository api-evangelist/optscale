    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an authentication token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}/restapi/v2/auth/v2/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an authentication token"
        }
      ]
    },
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
